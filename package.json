{
  "name": "reading-list",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "npm run dev:server & npm run dev:client",
    "dev:server": "tsc -b server && (tsc -b server --watch --preserveWatchOutput & node --watch server/dist/index.js)",
    "dev:client": "npm --prefix client run dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm --prefix client install --include=dev && npm --prefix client run build",
    "build:server": "tsc -b server",
    "start": "node server/dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
