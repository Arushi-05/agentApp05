{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "server/src",
    "outDir": "server/dist"
  },
  "include": ["server/src"],
  "references": [{ "path": "./shared" }]
}
